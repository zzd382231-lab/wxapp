.poster-page {
  padding: 24rpx;
  background: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.toolbar {
  margin-bottom: 20rpx;
}

.name-box,
.qr-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.qr-box {
  margin-top: 16rpx;
}

.label {
  color: #666;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.name-input {
  margin-top: 12rpx;
  height: 68rpx;
  line-height: 68rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
}

.qr-btn {
  margin: 0;
  font-size: 26rpx;
  background: #111;
  color: #fff;
}

.qr-tip {
  display: block;
  margin-top: 12rpx;
  color: #999;
  font-size: 22rpx;
}

.poster-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.poster-img,
.poster-preview {
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.poster-preview {
  margin-top: 20rpx;
  border: 1rpx solid #efefef;
}

.actions {
  display: flex;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  background: #f3f4f6;
  color: #333;
}

.action-btn + .action-btn {
  margin-left: 16rpx;
}

.action-btn.primary {
  background: #111;
  color: #fff;
}

.loading,
.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}
