@import './assets/fonts/iconfont.wxss';
@import './sass//global.wxss';
@import './pages/template/activityIndicator.wxss';
/**app.wxss**/
page {
  background: #fff;
  font-size: 26rpx;
}
.iphonex-bottom{
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background-color:#fff;
}
/* 防止启动时图片拉升 */
image {
  width: auto;
  height: auto;
}
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
.c-no-list,.c-no-data{
  padding-top: 130rpx;
  padding-bottom: 50rpx;
  position: relative;
  z-index: 4;
}
.c-no-list image {
  width: 373rpx;
  height: 295rpx;
  margin: 0 auto;
  display: block;
}
.c-no-data image{
  width: 340rpx;
  height: 277rpx;
}
.c-no-list text {
  color: #cdcdcd;
  font-size: 24rpx;
  margin-top: 40rpx;
  text-align: center;
  display: block;
}
